{
  "name": "@axolotl/plugin-repository",
  "version": "0.1.0",
  "description": "Tools for the Axolotl Plugin Repository",
  "private": true,
  "type": "module",
  "workspaces": [
    "tools/*"
  ],
  "scripts": {
    "validate": "npm run validate --workspace=tools/validator",
    "build": "echo \"No build step at M3 - code runs via tsx\"",
    "build:tools": "npm run typecheck --workspace=tools/builder",
    "generate": "echo \"registry-generator not yet implemented\"",
    "registry:validate": "tsx src/cli/validate-registry.ts",
    "submission:inspect": "tsx src/cli/inspect-submission.ts",
    "review": "tsx src/cli/review.ts",
    "materialize": "tsx src/cli/materialize.ts",
    "publish": "tsx src/cli/publish.ts",
    "registry:update": "tsx src/cli/update-registry.ts",
    "test": "vitest run",
    "test:registry": "vitest run tests/registry",
    "test:submission": "vitest run tests/submission",
    "test:review": "vitest run tests/review",
    "test:materialization": "vitest run tests/materialization",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1",
    "yaml": "^2.3.0",
    "zod": "^3.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  }
}
